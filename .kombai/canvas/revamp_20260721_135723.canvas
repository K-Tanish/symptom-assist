      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-white: #FFFFFF;\n    --slate-grey: #2F4F4F;\n    --steel-blue: #72A0C1;\n    --deep-crimson: #960018;\n    --hairline: #d0d0cc;\n  }\n\n  .font-sans { font-family: 'IBM Plex Sans', sans-serif; }\n  .font-serif { font-family: 'IBM Plex Serif', serif; }\n  \n  /* Resetting potential defaults to match sharp corners requirement */\n  * { border-radius: 0 !important; }\n\n  .browser-dot { width: 10px; height: 10px; border-radius: 50% !important; }\n</style>\n<div class=\"bg-[var(--bg-white)] text-[var(--slate-grey)] font-serif selection:bg-[var(--steel-blue)] selection:text-white\" data-kid=\"1\" data-name=\"main page container\">\n    <!-- Scroll Progress Bar (#motion-progress-bar) -->\n    <div class=\"fixed top-0 left-0 h-1 bg-[var(--steel-blue)] z-50 origin-left w-full scale-x-0\" data-dynamic=\"true\" data-kid=\"1-1\" data-name=\"scroll progress bar\" data-reason=\"width scale controlled by scroll position\" id=\"progress-bar\">\n    </div>\n    <!-- Main Navigation -->\n    <nav class=\"border-b border-[var(--hairline)] px-8 py-6 flex justify-between items-center sticky top-0 bg-white z-40\" data-kid=\"1-2\" data-name=\"navigation header\">\n        <div class=\"flex items-center gap-4\" data-kid=\"1-2-1\" data-name=\"brand logo and title group\">\n            <div class=\"w-10 h-10 bg-[var(--slate-grey)] flex items-center justify-center\" data-kid=\"1-2-1-1\" data-name=\"brand icon container\">\n                <svg class=\"w-6 h-6\" data-kid=\"1-2-1-1-1\" data-name=\"site logo icon\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                    <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\">\n                    </path>\n                </svg>\n            </div>\n            <div data-kid=\"1-2-1-2\" data-name=\"site name and subtitle group\">\n                <h1 class=\"font-sans font-bold text-lg leading-tight tracking-tight uppercase\" data-kid=\"1-2-1-2-1\" data-name=\"site headline\">\n                    SymptomAssist\n                </h1>\n                <p class=\"font-sans text-[10px] font-semibold tracking-widest uppercase opacity-60\" data-kid=\"1-2-1-2-2\" data-name=\"site sub-headline\">\n                    Cognitive Health Advisor\n                </p>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-8 font-sans text-xs font-bold tracking-widest uppercase\" data-kid=\"1-2-2\" data-name=\"navigation menu links\">\n            <a class=\"hover:text-[var(--steel-blue)] transition-colors\" data-kid=\"1-2-2-1\" data-name=\"archive navigation link\" href=\"#\">\n                Archive\n            </a>\n            <a class=\"hover:text-[var(--steel-blue)] transition-colors\" data-kid=\"1-2-2-2\" data-name=\"methodology navigation link\" href=\"#\">\n                Methodology\n            </a>\n            <a class=\"hover:text-[var(--steel-blue)] transition-colors\" data-kid=\"1-2-2-3\" data-name=\"pubmed api navigation link\" href=\"#\">\n                PubMed API\n            </a>\n            <button class=\"bg-[var(--slate-grey)] text-white px-6 py-3 hover:bg-black transition-colors\" data-kid=\"1-2-2-4\" data-name=\"start new session call-to-action button\">\n                Start New Session\n            </button>\n        </div>\n    </nav>\n    <!-- Hero Section (#split-overflow + #browser-mockup) -->\n    <section class=\"grid grid-cols-[38%_1fr] min-h-[85vh] border-b border-[var(--hairline)] overflow-visible\" data-kid=\"1-3\" data-name=\"hero section\">\n        <!-- Left Dark Panel -->\n        <div class=\"bg-[var(--slate-grey)] text-white p-12 flex flex-col justify-end relative\" data-kid=\"1-3-1\" data-name=\"dark hero info panel\">\n            <div class=\"max-w-md\" data-kid=\"1-3-1-1\" data-name=\"hero content block\" data-scroll=\"\">\n                <h2 class=\"font-sans font-bold text-5xl leading-[1.1] mb-8 uppercase tracking-tighter\" data-kid=\"1-3-1-1-1\" data-name=\"hero main headline\">\n                    Institutional\n                    <br data-kid=\"1-3-1-1-1-1\" data-name=\"headline line break\"/>\n                    Reasoning.\n                    <br data-kid=\"1-3-1-1-1-2\" data-name=\"headline line break\"/>\n                    Expert Clarity.\n                </h2>\n                <p class=\"text-lg leading-relaxed opacity-80 mb-12 italic\" data-kid=\"1-3-1-1-2\" data-name=\"hero description text\">\n                    High-fidelity medical symptom analysis powered by clinical knowledge graphs and real-time research synthesis.\n                </p>\n                <div class=\"flex flex-col gap-4\" data-kid=\"1-3-1-1-3\" data-name=\"system status block\">\n                    <div class=\"text-[10px] font-bold tracking-widest uppercase opacity-40\" data-kid=\"1-3-1-1-3-1\" data-name=\"system status label\">\n                        System Status\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-1-1-3-2\" data-name=\"system status indicator\">\n                        <div class=\"w-2 h-2 bg-green-400 rounded-full !rounded-full\" data-kid=\"1-3-1-1-3-2-1\" data-name=\"status light\">\n                        </div>\n                        <span class=\"font-sans text-xs font-bold\" data-kid=\"1-3-1-1-3-2-2\" data-name=\"status message text\">\n                            Node Traversal Active: 41 Conditions\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <!-- Decorative Image (photo-1639318533378-76d47c1e53f1) -->\n            <div class=\"absolute top-0 left-0 w-full h-1/2 opacity-10 pointer-events-none grayscale\" data-kid=\"1-3-1-2\" data-name=\"hero decorative image container\">\n                <img alt=\"Architectural detail\" class=\"w-full h-full object-cover\" data-kid=\"1-3-1-2-1\" data-name=\"architectural detail background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1639318533378-76d47c1e53f1?auto=format&w=800&q=80&fit=crop\"/>\n            </div>\n        </div>\n        <!-- Right White Panel + Overflow Browser Mockup -->\n        <div class=\"relative bg-[#F9F9F9] p-12 flex items-center\" data-kid=\"1-3-2\" data-name=\"chat interface panel\">\n            <div class=\"w-full -ml-32 z-10 shadow-2xl border border-[var(--hairline)] bg-white max-w-4xl\" data-kid=\"1-3-2-1\" data-name=\"chat window container\" data-scroll=\"\">\n                <!-- Browser Chrome -->\n                <div class=\"bg-[#F1F1F1] px-4 py-3 border-b border-[var(--hairline)] flex items-center justify-between\" data-kid=\"1-3-2-1-1\" data-name=\"browser chrome bar\">\n                    <div class=\"flex gap-2\" data-kid=\"1-3-2-1-1-1\" data-name=\"window control buttons container\">\n                        <div class=\"browser-dot bg-[#FF5F57]\" data-kid=\"1-3-2-1-1-1-1\" data-name=\"red browser button\">\n                        </div>\n                        <div class=\"browser-dot bg-[#FFBD2E]\" data-kid=\"1-3-2-1-1-1-2\" data-name=\"yellow browser button\">\n                        </div>\n                        <div class=\"browser-dot bg-[#28C840]\" data-kid=\"1-3-2-1-1-1-3\" data-name=\"green browser button\">\n                        </div>\n                    </div>\n                    <div class=\"bg-white border border-[var(--hairline)] px-12 py-1 text-[10px] font-sans text-center text-opacity-50 tracking-wide uppercase\" data-kid=\"1-3-2-1-1-2\" data-name=\"browser address field\">\n                        https://symptomassist.ai/session/v2-8812\n                    </div>\n                    <div class=\"w-12\" data-kid=\"1-3-2-1-1-3\" data-name=\"spacer element\">\n                    </div>\n                </div>\n                <!-- Chat Interface Mockup -->\n                <div class=\"p-8 min-h-[500px] flex flex-col gap-6 font-sans\" data-kid=\"1-3-2-1-2\" data-name=\"chat content area\">\n                    <div class=\"flex gap-4\" data-kid=\"1-3-2-1-2-1\" data-name=\"ai message block 1\">\n                        <div class=\"w-8 h-8 bg-[var(--slate-grey)] flex-shrink-0 flex items-center justify-center text-[10px] text-white font-bold\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"ai avatar icon\">\n                            AI\n                        </div>\n                        <div class=\"bg-gray-50 border border-[var(--hairline)] p-4 max-w-lg text-sm leading-relaxed\" data-kid=\"1-3-2-1-2-1-2\" data-name=\"ai response text 1\">\n                            Describe your symptoms in detail. The knowledge graph will be traversed to identify likely conditions.\n                        </div>\n                    </div>\n                    <div class=\"flex gap-4 flex-row-reverse\" data-kid=\"1-3-2-1-2-2\" data-name=\"user message block\">\n                        <div class=\"w-8 h-8 bg-black flex-shrink-0 flex items-center justify-center text-[10px] text-white font-bold italic\" data-kid=\"1-3-2-1-2-2-1\" data-name=\"user avatar icon\">\n                            ME\n                        </div>\n                        <div class=\"bg-[var(--slate-grey)] text-white p-4 max-w-lg text-sm leading-relaxed border border-[var(--slate-grey)]\" data-kid=\"1-3-2-1-2-2-2\" data-name=\"user inquiry text\">\n                            I've been feeling fatigue, weight loss, frequent urination, and increased thirst for two weeks.\n                        </div>\n                    </div>\n                    <div class=\"flex gap-4\" data-kid=\"1-3-2-1-2-3\" data-name=\"ai message block 2\">\n                        <div class=\"w-8 h-8 bg-[var(--slate-grey)] flex-shrink-0 flex items-center justify-center text-[10px] text-white font-bold\" data-kid=\"1-3-2-1-2-3-1\" data-name=\"ai avatar icon\">\n                            AI\n                        </div>\n                        <div class=\"bg-gray-50 border border-[var(--hairline)] p-4 max-w-lg text-sm leading-relaxed\" data-kid=\"1-3-2-1-2-3-2\" data-name=\"ai response text 2\">\n                            Analyzing traversal matches... Have you noticed any vision changes or persistent headaches?\n                        </div>\n                    </div>\n                    <!-- Mock Input Area -->\n                    <div class=\"mt-auto border-t border-[var(--hairline)] pt-6\" data-kid=\"1-3-2-1-2-4\" data-name=\"input interaction area\">\n                        <div class=\"flex gap-2 mb-4\" data-kid=\"1-3-2-1-2-4-1\" data-name=\"suggested keywords header\">\n                            <span class=\"text-[9px] font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"1-3-2-1-2-4-1-1\" data-name=\"suggestions label\">\n                                Suggestions:\n                            </span>\n                            <span class=\"text-[9px] font-bold text-[var(--slate-grey)] bg-gray-100 px-2 py-1 cursor-pointer hover:bg-gray-200\" data-kid=\"1-3-2-1-2-4-1-2\" data-name=\"suggestion button 1\">\n                                Vision Blur\n                            </span>\n                            <span class=\"text-[9px] font-bold text-[var(--slate-grey)] bg-gray-100 px-2 py-1 cursor-pointer hover:bg-gray-200\" data-kid=\"1-3-2-1-2-4-1-3\" data-name=\"suggestion button 2\">\n                                Chronic Thirst\n                            </span>\n                        </div>\n                        <div class=\"flex items-center border border-[var(--slate-grey)] p-1\" data-kid=\"1-3-2-1-2-4-2\" data-name=\"chat text input field group\">\n                            <input class=\"flex-1 px-4 py-2 text-sm outline-none font-serif\" data-kid=\"1-3-2-1-2-4-2-1\" data-name=\"chat message text input\" placeholder=\"Describe symptoms...\" type=\"text\"/>\n                            <button class=\"bg-[var(--slate-grey)] text-white p-2\" data-kid=\"1-3-2-1-2-4-2-2\" data-name=\"submit message button\">\n                                <i class=\"ti ti-arrow-right\" data-kid=\"1-3-2-1-2-4-2-2-1\" data-name=\"submit icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Triage & Alert Panel (Institutional Red Flags) -->\n    <section class=\"bg-[var(--bg-white)] border-b border-[var(--hairline)] p-8\" data-kid=\"1-4\" data-name=\"urgent triage section\">\n        <div class=\"flex items-start gap-12 max-w-7xl mx-auto\" data-kid=\"1-4-1\" data-name=\"triage content wrapper\">\n            <div class=\"w-48 flex-shrink-0 pt-2\" data-kid=\"1-4-1-1\" data-name=\"urgent alert heading group\">\n                <h3 class=\"font-sans font-bold text-xs uppercase tracking-[0.2em] text-[var(--deep-crimson)] flex items-center gap-2\" data-kid=\"1-4-1-1-1\" data-name=\"urgent triage title\">\n                    <i class=\"ti ti-alert-triangle\" data-kid=\"1-4-1-1-1-1\" data-name=\"alert warning icon\">\n                    </i>\n                    Urgent Triage\n                </h3>\n            </div>\n            <div class=\"flex-1 bg-[#fef2f2] border border-[#fecaca] p-6\" data-kid=\"1-4-1-2\" data-name=\"priority flags detail box\">\n                <div class=\"flex justify-between items-center mb-4\" data-kid=\"1-4-1-2-1\" data-name=\"priority header row\">\n                    <h4 class=\"font-sans font-bold text-sm text-[var(--deep-crimson)]\" data-kid=\"1-4-1-2-1-1\" data-name=\"priority red flags title\">\n                        Priority Red Flags Detected\n                    </h4>\n                    <span class=\"text-[10px] font-bold text-[var(--deep-crimson)] uppercase bg-white border border-[#fecaca] px-2 py-1\" data-kid=\"1-4-1-2-1-2\" data-name=\"severity badge\">\n                        Severity: High\n                    </span>\n                </div>\n                <ul class=\"font-sans text-sm space-y-2 text-[#991b1b]\" data-kid=\"1-4-1-2-2\" data-name=\"red flags list\">\n                    <li class=\"flex items-center gap-2\" data-kid=\"1-4-1-2-2-1\" data-name=\"flag item 1\">\n                        <i class=\"ti ti-circle-check\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"check mark icon\">\n                        </i>\n                        Unexplained weight loss (>5% in 6 months)\n                    </li>\n                    <li class=\"flex items-center gap-2\" data-kid=\"1-4-1-2-2-2\" data-name=\"flag item 2\">\n                        <i class=\"ti ti-circle-check\" data-kid=\"1-4-1-2-2-2-1\" data-name=\"check mark icon\">\n                        </i>\n                        Polyuria (Frequent urination) paired with polydipsia (Excessive thirst)\n                    </li>\n                </ul>\n            </div>\n        </div>\n    </section>\n    <!-- Expert Analysis Section (#master-detail + #classic-table) -->\n    <section class=\"grid grid-cols-[300px_1fr] min-h-[600px] border-b border-[var(--hairline)] max-w-7xl mx-auto\" data-kid=\"1-5\" data-name=\"expert analysis section\">\n        <!-- Master List -->\n        <div class=\"border-r border-[var(--hairline)] p-8 bg-gray-50/50\" data-kid=\"1-5-1\" data-name=\"symptom list panel\">\n            <h3 class=\"font-sans font-bold text-[10px] uppercase tracking-[0.2em] mb-8 opacity-60\" data-kid=\"1-5-1-1\" data-name=\"extracted symptoms label\">\n                Extracted Symptoms\n            </h3>\n            <div class=\"space-y-4\" data-kid=\"1-5-1-2\" data-name=\"symptom list\">\n                <div class=\"border-l-4 border-[var(--slate-grey)] bg-white p-4 shadow-sm\" data-kid=\"1-5-1-2-1\" data-name=\"fatigue item\">\n                    <p class=\"font-sans text-sm font-bold\" data-kid=\"1-5-1-2-1-1\" data-name=\"fatigue item name\">\n                        Fatigue\n                    </p>\n                    <span class=\"text-[10px] opacity-60\" data-kid=\"1-5-1-2-1-2\" data-name=\"fatigue status label\">\n                        Reported: Primary\n                    </span>\n                </div>\n                <div class=\"border-l-4 border-transparent hover:border-gray-300 p-4 transition-all cursor-pointer\" data-kid=\"1-5-1-2-2\" data-name=\"weight loss item\">\n                    <p class=\"font-sans text-sm font-bold opacity-60\" data-kid=\"1-5-1-2-2-1\" data-name=\"weight loss item name\">\n                        Weight Loss\n                    </p>\n                    <span class=\"text-[10px] opacity-40 italic\" data-kid=\"1-5-1-2-2-2\" data-name=\"weight loss status label\">\n                        Traversal Key\n                    </span>\n                </div>\n                <div class=\"border-l-4 border-transparent hover:border-gray-300 p-4 transition-all cursor-pointer\" data-kid=\"1-5-1-2-3\" data-name=\"frequent urination item\">\n                    <p class=\"font-sans text-sm font-bold opacity-60\" data-kid=\"1-5-1-2-3-1\" data-name=\"frequent urination item name\">\n                        Frequent Urination\n                    </p>\n                    <span class=\"text-[10px] opacity-40 italic\" data-kid=\"1-5-1-2-3-2\" data-name=\"frequent urination status label\">\n                        Traversal Key\n                    </span>\n                </div>\n                <div class=\"border-l-4 border-transparent hover:border-gray-300 p-4 transition-all cursor-pointer\" data-kid=\"1-5-1-2-4\" data-name=\"increased thirst item\">\n                    <p class=\"font-sans text-sm font-bold opacity-60\" data-kid=\"1-5-1-2-4-1\" data-name=\"increased thirst item name\">\n                        Increased Thirst\n                    </p>\n                    <span class=\"text-[10px] opacity-40 italic\" data-kid=\"1-5-1-2-4-2\" data-name=\"increased thirst status label\">\n                        Traversal Key\n                    </span>\n                </div>\n            </div>\n        </div>\n        <!-- Detail View: Condition Table (#classic-table) -->\n        <div class=\"p-12\" data-kid=\"1-5-2\" data-name=\"detail view panel\">\n            <div class=\"flex justify-between items-end mb-8\" data-kid=\"1-5-2-1\" data-name=\"detail view header\">\n                <div data-kid=\"1-5-2-1-1\" data-name=\"traversal matches heading group\">\n                    <h3 class=\"font-sans font-bold text-xs uppercase tracking-[0.2em] mb-2\" data-kid=\"1-5-2-1-1-1\" data-name=\"traversal matches title\">\n                        Traversal Matches\n                    </h3>\n                    <p class=\"text-sm italic text-gray-500\" data-kid=\"1-5-2-1-1-2\" data-name=\"traversal description\">\n                        Bayesian probability mapping against clinical data sets.\n                    </p>\n                </div>\n                <button class=\"flex items-center gap-2 font-sans text-[10px] font-bold tracking-widest uppercase border border-[var(--slate-grey)] px-4 py-2 hover:bg-gray-100\" data-kid=\"1-5-2-1-2\" data-name=\"export summary button\">\n                    <i class=\"ti ti-printer\" data-kid=\"1-5-2-1-2-1\" data-name=\"printer icon\">\n                    </i>\n                    Export Summary\n                </button>\n            </div>\n            <table class=\"w-full text-left font-sans text-sm\" data-kid=\"1-5-2-2\" data-name=\"diagnostic matches table\">\n                <thead data-kid=\"1-5-2-2-1\" data-name=\"table header row\">\n                    <tr class=\"border-b-2 border-[var(--slate-grey)] text-[10px] font-bold uppercase tracking-wider\" data-kid=\"1-5-2-2-1-1\" data-name=\"diagnostic match header\">\n                        <th class=\"py-4 px-2\" data-kid=\"1-5-2-2-1-1-1\" data-name=\"diagnostic match label\">\n                            Diagnostic Match\n                        </th>\n                        <th class=\"py-4 px-2\" data-kid=\"1-5-2-2-1-1-2\" data-name=\"confidence label\">\n                            Confidence\n                        </th>\n                        <th class=\"py-4 px-2\" data-kid=\"1-5-2-2-1-1-3\" data-name=\"evidence count label\">\n                            Evidence Count\n                        </th>\n                        <th class=\"py-4 px-2\" data-kid=\"1-5-2-2-1-1-4\" data-name=\"status label\">\n                            Status\n                        </th>\n                    </tr>\n                </thead>\n                <tbody class=\"divide-y divide-[var(--hairline)]\" data-kid=\"1-5-2-2-2\" data-name=\"table body\">\n                    <tr class=\"hover:bg-gray-50 transition-colors\" data-kid=\"1-5-2-2-2-1\" data-name=\"diabetes match row\">\n                        <td class=\"py-6 px-2 font-bold\" data-kid=\"1-5-2-2-2-1-1\" data-name=\"diabetes match name\">\n                            Diabetes Mellitus (Type 2)\n                        </td>\n                        <td class=\"py-6 px-2\" data-kid=\"1-5-2-2-2-1-2\" data-name=\"confidence meter cell\">\n                            <div class=\"w-32 h-2 bg-gray-100 relative\" data-kid=\"1-5-2-2-2-1-2-1\" data-name=\"confidence bar track\">\n                                <div class=\"absolute top-0 left-0 h-full bg-[var(--steel-blue)] w-[82%]\" data-kid=\"1-5-2-2-2-1-2-1-1\" data-name=\"diabetes confidence fill bar\">\n                                </div>\n                            </div>\n                        </td>\n                        <td class=\"py-6 px-2 text-xs\" data-kid=\"1-5-2-2-2-1-3\" data-name=\"evidence count\">\n                            4/4 Key Indicators\n                        </td>\n                        <td class=\"py-6 px-2\" data-kid=\"1-5-2-2-2-1-4\" data-name=\"urgency status badge\">\n                            <span class=\"bg-[#fef2f2] text-[var(--deep-crimson)] border border-[#fecaca] px-3 py-1 text-[10px] font-bold\" data-kid=\"1-5-2-2-2-1-4-1\" data-name=\"urgent status label\">\n                                URGENT\n                            </span>\n                        </td>\n                    </tr>\n                    <tr class=\"hover:bg-gray-50 transition-colors\" data-kid=\"1-5-2-2-2-2\" data-name=\"hyperthyroidism match row\">\n                        <td class=\"py-6 px-2 font-bold\" data-kid=\"1-5-2-2-2-2-1\" data-name=\"hyperthyroidism match name\">\n                            Hyperthyroidism\n                        </td>\n                        <td class=\"py-6 px-2\" data-kid=\"1-5-2-2-2-2-2\" data-name=\"hyperthyroidism confidence cell\">\n                            <div class=\"w-32 h-2 bg-gray-100 relative\" data-kid=\"1-5-2-2-2-2-2-1\" data-name=\"hyperthyroidism bar track\">\n                                <div class=\"absolute top-0 left-0 h-full bg-[var(--steel-blue)] w-[45%]\" data-kid=\"1-5-2-2-2-2-2-1-1\" data-name=\"hyperthyroidism confidence fill bar\">\n                                </div>\n                            </div>\n                        </td>\n                        <td class=\"py-6 px-2 text-xs\" data-kid=\"1-5-2-2-2-2-3\" data-name=\"hyperthyroidism evidence count\">\n                            2/4 Key Indicators\n                        </td>\n                        <td class=\"py-6 px-2\" data-kid=\"1-5-2-2-2-2-4\" data-name=\"monitor status badge\">\n                            <span class=\"bg-blue-50 text-[var(--steel-blue)] border border-blue-100 px-3 py-1 text-[10px] font-bold\" data-kid=\"1-5-2-2-2-2-4-1\" data-name=\"monitor status label\">\n                                MONITOR\n                            </span>\n                        </td>\n                    </tr>\n                    <tr class=\"hover:bg-gray-50 transition-colors\" data-kid=\"1-5-2-2-2-3\" data-name=\"diabetes insipidus match row\">\n                        <td class=\"py-6 px-2 font-bold\" data-kid=\"1-5-2-2-2-3-1\" data-name=\"diabetes insipidus match name\">\n                            Diabetes Insipidus\n                        </td>\n                        <td class=\"py-6 px-2\" data-kid=\"1-5-2-2-2-3-2\" data-name=\"diabetes insipidus confidence cell\">\n                            <div class=\"w-32 h-2 bg-gray-100 relative\" data-kid=\"1-5-2-2-2-3-2-1\" data-name=\"diabetes insipidus bar track\">\n                                <div class=\"absolute top-0 left-0 h-full bg-[var(--steel-blue)] w-[30%]\" data-kid=\"1-5-2-2-2-3-2-1-1\" data-name=\"diabetes insipidus confidence fill bar\">\n                                </div>\n                            </div>\n                        </td>\n                        <td class=\"py-6 px-2 text-xs\" data-kid=\"1-5-2-2-2-3-3\" data-name=\"diabetes insipidus evidence count\">\n                            1/4 Key Indicators\n                        </td>\n                        <td class=\"py-6 px-2\" data-kid=\"1-5-2-2-2-3-4\" data-name=\"low match status badge\">\n                            <span class=\"bg-gray-50 text-gray-500 border border-gray-100 px-3 py-1 text-[10px] font-bold\" data-kid=\"1-5-2-2-2-3-4-1\" data-name=\"low match status label\">\n                                LOW MATCH\n                            </span>\n                        </td>\n                    </tr>\n                </tbody>\n            </table>\n            <div class=\"mt-12 p-8 border-2 border-dashed border-[var(--hairline)] flex flex-col items-center justify-center text-center\" data-kid=\"1-5-2-3\" data-name=\"visualizer placeholder box\">\n                <div class=\"w-12 h-12 text-gray-300 mb-4\" data-kid=\"1-5-2-3-1\" data-name=\"placeholder icon container\">\n                    <i class=\"ti ti-binary text-5xl\" data-kid=\"1-5-2-3-1-1\" data-name=\"binary icon\">\n                    </i>\n                </div>\n                <h4 class=\"font-sans font-bold text-xs uppercase mb-2\" data-kid=\"1-5-2-3-2\" data-name=\"placeholder heading\">\n                    BFS Traversal Visualization\n                </h4>\n                <p class=\"text-sm italic opacity-50 max-w-sm\" data-kid=\"1-5-2-3-3\" data-name=\"placeholder description\">\n                    Interactive knowledge graph mapping nodes in real-time. Toggle 'Knowledge Graph' to view expanded network.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"p-12 bg-[var(--slate-grey)] text-white text-center\" data-kid=\"1-6\" data-name=\"footer section\">\n        <div class=\"max-w-2xl mx-auto\" data-kid=\"1-6-1\" data-name=\"footer content container\">\n            <p class=\"font-serif text-sm italic opacity-60 mb-8 leading-relaxed\" data-kid=\"1-6-1-1\" data-name=\"disclaimer text\">\n                SymptomAssist is an institutional cognitive tool designed for educational synthesis of clinical data. \n        It is not a substitute for professional medical advice, diagnosis, or treatment.\n            </p>\n            <div class=\"flex justify-center gap-12 font-sans text-[10px] font-bold uppercase tracking-[0.2em] opacity-40\" data-kid=\"1-6-1-2\" data-name=\"footer meta details\">\n                <span data-kid=\"1-6-1-2-1\" data-name=\"copyright text\">\n                    © 2026 Institutional Health AI\n                </span>\n                <span data-kid=\"1-6-1-2-2\" data-name=\"protocol compliance label\">\n                    HIPAA Compliant Protocol\n                </span>\n                <span data-kid=\"1-6-1-2-3\" data-name=\"version number label\">\n                    Version 4.2.0-STABLE\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n  \n  gsap.registerPlugin(ScrollTrigger);\n  \n  // Smooth Scroll\n  const lenis = new Lenis();\n  lenis.on('scroll', ScrollTrigger.update);\n  gsap.ticker.add((time) => {\n    lenis.raf(time * 1000);\n  });\n  gsap.ticker.lagSmoothing(0);\n\n  // Entrance reveals\n  gsap.from(\"[data-scroll]\", {\n    autoAlpha: 0,\n    y: 30,\n    duration: 1,\n    stagger: 0.2,\n    ease: \"power3.out\",\n    scrollTrigger: {\n      trigger: \"[data-scroll]\",\n      start: \"top 90%\"\n    }\n  });\n\n  // Progress bar\n  gsap.to(\"#progress-bar\", {\n    scaleX: 1,\n    ease: \"none\",\n    scrollTrigger: {\n      trigger: \"body\",\n      start: \"top top\",\n      end: \"bottom bottom\",\n      scrub: 0.3\n    }\n  });\n\n  // Mask wipes for specific headers\n  gsap.from(\"h2\", {\n    clipPath: \"inset(0 100% 0 0)\",\n    duration: 1.2,\n    ease: \"power4.inOut\"\n  });\n</script>\n",
      "comments": [],
      "created": "2026-07-21T14:02:10.192995+00:00",
      "modified": "2026-07-21T14:02:48.807199+00:00",
      "id": "var_e0b7f05132bc"
    },
    "var_30b9cf99b77a": {
      "type": "variant",
      "label": "Direction 1: Calm Clinical",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Public+Sans:ital,wght@0,100..900;1,100..900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-linen: #F8FAF0;\n    --color-spruce: #1E4D2B;\n    --color-chartreuse: #DFFF00;\n    --color-border: #d0d0cc;\n    --color-spruce-soft: rgba(30, 77, 43, 0.05);\n  }\n\n  body {\n    background-color: var(--color-linen);\n    color: var(--color-spruce);\n    font-family: 'Public Sans', sans-serif;\n    margin: 0;\n    padding: 0;\n  }\n\n  h1, h2, h3, h4, h5, h6 {\n    font-family: 'Atkinson Hyperlegible', sans-serif;\n    font-weight: 700;\n    letter-spacing: -0.01em;\n  }\n\n  .font-hyperlegible {\n    font-family: 'Atkinson Hyperlegible', sans-serif;\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar {\n    width: 6px;\n  }\n  ::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  ::-webkit-scrollbar-thumb {\n    background: #d1d5db;\n    border-radius: 10px;\n  }\n  ::-webkit-scrollbar-thumb:hover {\n    background: #9ca3af;\n  }\n</style>\n<div class=\"min-h-screen flex flex-col selection:bg-[var(--color-chartreuse)] selection:text-[var(--color-spruce)]\" data-kid=\"1\">\n    <!-- Navigation -->\n    <nav class=\"sticky top-0 z-50 bg-[var(--color-linen)]/80 backdrop-blur-md border-b border-[var(--color-border)] px-8 py-4 flex items-center justify-between\" data-kid=\"1-1\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-1-1\">\n            <div class=\"w-10 h-10 bg-[var(--color-spruce)] rounded-lg flex items-center justify-center text-[var(--color-chartreuse)]\" data-kid=\"1-1-1-1\">\n                <i class=\"ti ti-pulse text-2xl\" data-kid=\"1-1-1-1-1\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\">\n                <h1 class=\"text-xl leading-none\" data-kid=\"1-1-1-2-1\">\n                    SymptomAssist\n                </h1>\n                <p class=\"text-[10px] uppercase tracking-widest font-bold opacity-60\" data-kid=\"1-1-1-2-2\">\n                    Cognitive Health Advisor\n                </p>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-6\" data-kid=\"1-1-2\">\n            <div class=\"flex items-center gap-2 px-3 py-1.5 bg-white border border-[var(--color-border)] rounded-full text-[11px] font-bold uppercase tracking-wider\" data-kid=\"1-1-2-1\">\n                <span class=\"w-2 h-2 bg-green-500 rounded-full animate-pulse\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1\" data-name=\"live analysis status indicator\" data-reason=\"pulsing animation state managed by CSS\">\n                </span>\n                Live Analysis\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-2\">\n                <button class=\"px-4 py-2 text-xs font-bold uppercase tracking-wide border border-[var(--color-border)] rounded-lg hover:bg-white transition-colors\" data-kid=\"1-1-2-2-1\">\n                    Summary\n                </button>\n                <button class=\"px-4 py-2 text-xs font-bold uppercase tracking-wide bg-[var(--color-spruce)] text-white rounded-lg hover:opacity-90 transition-opacity\" data-kid=\"1-1-2-2-2\">\n                    New Session\n                </button>\n            </div>\n        </div>\n    </nav>\n    <main class=\"flex-1 flex overflow-hidden h-[calc(100vh-73px)]\" data-kid=\"1-2\">\n        <!-- Sidebar History -->\n        <aside class=\"w-64 border-r border-[var(--color-border)] flex flex-col bg-white/50\" data-kid=\"1-2-1\">\n            <div class=\"p-6 border-b border-[var(--color-border)]\" data-kid=\"1-2-1-1\">\n                <h3 class=\"text-xs font-bold uppercase tracking-widest opacity-50 mb-4\" data-kid=\"1-2-1-1-1\">\n                    Past Explorations\n                </h3>\n                <div class=\"space-y-2\" data-kid=\"1-2-1-1-2\">\n                    <div class=\"p-3 bg-white border border-[var(--color-border)] rounded-xl text-sm font-medium hover:border-[var(--color-spruce)] cursor-pointer transition-colors\" data-kid=\"1-2-1-1-2-1\">\n                        Persistent fatigue & weight loss\n                        <div class=\"text-[10px] opacity-50 mt-1\" data-kid=\"1-2-1-1-2-1-1\">\n                            2 hours ago\n                        </div>\n                    </div>\n                    <div class=\"p-3 hover:bg-white rounded-xl text-sm opacity-60 cursor-pointer transition-colors\" data-kid=\"1-2-1-1-2-2\">\n                        Acute lower back pain\n                        <div class=\"text-[10px] opacity-50 mt-1\" data-kid=\"1-2-1-1-2-2-1\">\n                            Yesterday\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-auto p-6\" data-kid=\"1-2-1-2\">\n                <div class=\"bg-[var(--color-spruce)] p-4 rounded-2xl text-white relative overflow-hidden\" data-kid=\"1-2-1-2-1\">\n                    <div class=\"relative z-10\" data-kid=\"1-2-1-2-1-1\">\n                        <h4 class=\"text-sm font-bold mb-1\" data-kid=\"1-2-1-2-1-1-1\">\n                            Knowledge Hub\n                        </h4>\n                        <p class=\"text-[11px] opacity-70 leading-relaxed\" data-kid=\"1-2-1-2-1-1-2\">\n                            Access 130+ symptom mappings and PubMed peer-reviewed data.\n                        </p>\n                    </div>\n                    <i class=\"ti ti-book-2 absolute -bottom-4 -right-4 text-6xl opacity-10\" data-kid=\"1-2-1-2-1-2\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <!-- Chat/Hero Section -->\n        <section class=\"flex-1 flex flex-col bg-white relative\" data-kid=\"1-2-2\">\n            <div class=\"absolute inset-0 z-10 flex flex-col p-8 opacity-0 pointer-events-none\" data-dynamic=\"true\" data-kid=\"1-2-2-1\" data-name=\"chat conversation area\" data-reason=\"visibility and content triggered by JS on session start\" id=\"chat-reveal\">\n                <div class=\"flex-1 overflow-y-auto space-y-8 pr-4\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1\" data-name=\"chat scrollable message list\" data-reason=\"children injected by JS session logic\">\n                    <!-- AI Welcome -->\n                    <div class=\"flex gap-4 max-w-2xl\" data-kid=\"1-2-2-1-1-1\">\n                        <div class=\"w-8 h-8 rounded-full bg-[var(--color-spruce-soft)] border border-[var(--color-border)] flex items-center justify-center shrink-0\" data-kid=\"1-2-2-1-1-1-1\">\n                            <i class=\"ti ti-robot text-[var(--color-spruce)]\" data-kid=\"1-2-2-1-1-1-1-1\">\n                            </i>\n                        </div>\n                        <div class=\"space-y-2\" data-kid=\"1-2-2-1-1-1-2\">\n                            <div class=\"bg-[var(--color-linen)] p-4 rounded-2xl rounded-tl-none border border-[var(--color-border)] text-sm leading-relaxed\" data-kid=\"1-2-2-1-1-1-2-1\">\n                                Welcome to SymptomAssist AI. Describe your symptoms in detail — I'll traverse our medical knowledge graph to identify likely conditions. How are you feeling today?\n                            </div>\n                        </div>\n                    </div>\n                    <!-- User Message -->\n                    <div class=\"flex gap-4 max-w-2xl ml-auto flex-row-reverse\" data-kid=\"1-2-2-1-1-2\">\n                        <div class=\"w-8 h-8 rounded-full bg-[var(--color-spruce)] flex items-center justify-center shrink-0 text-white\" data-kid=\"1-2-2-1-1-2-1\">\n                            <i class=\"ti ti-user\" data-kid=\"1-2-2-1-1-2-1-1\">\n                            </i>\n                        </div>\n                        <div class=\"bg-[var(--color-spruce)] text-white p-4 rounded-2xl rounded-tr-none text-sm leading-relaxed shadow-lg\" data-kid=\"1-2-2-1-1-2-2\">\n                            I have been feeling fatigue, weight loss, frequent urination, and increased thirst.\n                        </div>\n                    </div>\n                    <!-- AI Reasoning Reveal -->\n                    <div class=\"flex gap-4 max-w-2xl\" data-kid=\"1-2-2-1-1-3\">\n                        <div class=\"w-8 h-8 rounded-full bg-[var(--color-spruce-soft)] border border-[var(--color-border)] flex items-center justify-center shrink-0\" data-kid=\"1-2-2-1-1-3-1\">\n                            <i class=\"ti ti-robot text-[var(--color-spruce)]\" data-kid=\"1-2-2-1-1-3-1-1\">\n                            </i>\n                        </div>\n                        <div class=\"space-y-4\" data-kid=\"1-2-2-1-1-3-2\">\n                            <div class=\"bg-[var(--color-linen)] p-4 rounded-2xl rounded-tl-none border border-[var(--color-border)] text-sm leading-relaxed\" data-kid=\"1-2-2-1-1-3-2-1\">\n                                These symptoms are significant. They may suggest a metabolic condition related to blood sugar regulation.\n                            </div>\n                            <div class=\"p-4 bg-[var(--color-chartreuse)]/20 border border-[var(--color-chartreuse)] rounded-2xl text-xs font-bold text-[var(--color-spruce)] flex items-center gap-3\" data-kid=\"1-2-2-1-1-3-2-2\">\n                                <i class=\"ti ti-alert-triangle text-lg\" data-kid=\"1-2-2-1-1-3-2-2-1\">\n                                </i>\n                                Clinical Note: Priority evaluation for Diabetes Mellitus (Type 1 or 2) suggested.\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- Input Area (Fixed) -->\n                <div class=\"mt-8 border-t border-[var(--color-border)] pt-8\" data-kid=\"1-2-2-1-2\">\n                    <div class=\"relative\" data-kid=\"1-2-2-1-2-1\">\n                        <input class=\"w-full bg-[var(--color-linen)] border border-[var(--color-border)] rounded-2xl px-6 py-5 text-sm outline-hidden focus:border-[var(--color-spruce)] transition-colors pr-32\" data-kid=\"1-2-2-1-2-1-1\" placeholder=\"Add more symptoms or details...\" type=\"text\"/>\n                        <div class=\"absolute right-3 top-1/2 -translate-y-1/2 flex items-center gap-2\" data-kid=\"1-2-2-1-2-1-2\">\n                            <button class=\"w-10 h-10 flex items-center justify-center rounded-xl hover:bg-white transition-colors text-slate-400\" data-kid=\"1-2-2-1-2-1-2-1\">\n                                <i class=\"ti ti-microphone text-xl\" data-kid=\"1-2-2-1-2-1-2-1-1\">\n                                </i>\n                            </button>\n                            <button class=\"w-10 h-10 flex items-center justify-center rounded-xl hover:bg-white transition-colors text-slate-400\" data-kid=\"1-2-2-1-2-1-2-2\">\n                                <i class=\"ti ti-photo text-xl\" data-kid=\"1-2-2-1-2-1-2-2-1\">\n                                </i>\n                            </button>\n                            <button class=\"w-12 h-12 flex items-center justify-center rounded-xl bg-[var(--color-spruce)] text-white hover:opacity-90 transition-opacity\" data-kid=\"1-2-2-1-2-1-2-3\">\n                                <i class=\"ti ti-arrow-right text-xl\" data-kid=\"1-2-2-1-2-1-2-3-1\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center justify-between mt-4 px-2\" data-kid=\"1-2-2-1-2-2\">\n                        <label class=\"flex items-center gap-2 cursor-pointer group\" data-kid=\"1-2-2-1-2-2-1\">\n                            <input class=\"sr-only peer\" data-kid=\"1-2-2-1-2-2-1-1\" type=\"checkbox\"/>\n                            <div class=\"w-8 h-4 bg-slate-200 rounded-full relative peer-checked:bg-[var(--color-spruce)] transition-colors\" data-kid=\"1-2-2-1-2-2-1-2\">\n                                <div class=\"absolute top-0.5 left-0.5 w-3 h-3 bg-white rounded-full transition-transform peer-checked:translate-x-4\" data-kid=\"1-2-2-1-2-2-1-2-1\">\n                                </div>\n                            </div>\n                            <span class=\"text-[10px] font-bold uppercase tracking-wider opacity-60 group-hover:opacity-100\" data-kid=\"1-2-2-1-2-2-1-3\">\n                                Deep Research (PubMed)\n                            </span>\n                        </label>\n                        <p class=\"text-[10px] opacity-40 italic\" data-kid=\"1-2-2-1-2-2-2\">\n                            Not a substitute for professional medical advice. Emergency? Call 911/108.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <!-- Hero Flashboard -->\n            <div class=\"absolute inset-0 flex\" data-dynamic=\"true\" data-kid=\"1-2-2-2\" data-name=\"hero section flashboard container\" data-reason=\"visibility and display toggled by JS on session start\" id=\"hero-split\">\n                <div class=\"flex-1 p-16 flex flex-col justify-center max-w-xl\" data-kid=\"1-2-2-2-1\">\n                    <div class=\"mb-8\" data-kid=\"1-2-2-2-1-1\">\n                        <span class=\"px-3 py-1 bg-[var(--color-chartreuse)] text-[var(--color-spruce)] text-[10px] font-bold uppercase tracking-widest rounded-full\" data-kid=\"1-2-2-2-1-1-1\">\n                            New Session\n                        </span>\n                        <h2 class=\"text-6xl mt-6 leading-tight font-hyperlegible\" data-kid=\"1-2-2-2-1-1-2\">\n                            Clarity in Every Symptom.\n                        </h2>\n                        <p class=\"text-lg mt-6 opacity-70 leading-relaxed\" data-kid=\"1-2-2-2-1-1-3\">\n                            Describe your feelings in plain text. Our Bayesian medical graph traverses 130+ symptoms to find clear clinical paths.\n                        </p>\n                    </div>\n                    <div class=\"relative group\" data-kid=\"1-2-2-2-1-2\" id=\"hero-input-container\">\n                        <input class=\"w-full bg-white border-2 border-[var(--color-spruce)] rounded-2xl px-8 py-6 text-lg outline-hidden focus:ring-4 focus:ring-[var(--color-chartreuse)]/30 transition-all pr-20\" data-kid=\"1-2-2-2-1-2-1\" id=\"hero-input\" placeholder=\"Describe how you're feeling today...\" type=\"text\"/>\n                        <button class=\"absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-[var(--color-spruce)] text-white rounded-xl flex items-center justify-center text-xl hover:translate-x-1 transition-transform\" data-kid=\"1-2-2-2-1-2-2\" id=\"hero-start\">\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-2-2-2-1-2-2-1\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"mt-8 flex flex-wrap gap-2\" data-kid=\"1-2-2-2-1-3\">\n                        <button class=\"px-4 py-2 bg-[var(--color-spruce-soft)] text-[var(--color-spruce)] text-xs font-bold rounded-lg hover:bg-[var(--color-chartreuse)]/20 transition-colors\" data-kid=\"1-2-2-2-1-3-1\">\n                            Fever and dry cough\n                        </button>\n                        <button class=\"px-4 py-2 bg-[var(--color-spruce-soft)] text-[var(--color-spruce)] text-xs font-bold rounded-lg hover:bg-[var(--color-chartreuse)]/20 transition-colors\" data-kid=\"1-2-2-2-1-3-2\">\n                            Severe headache\n                        </button>\n                        <button class=\"px-4 py-2 bg-[var(--color-spruce-soft)] text-[var(--color-spruce)] text-xs font-bold rounded-lg hover:bg-[var(--color-chartreuse)]/20 transition-colors\" data-kid=\"1-2-2-2-1-3-3\">\n                            Sore throat\n                        </button>\n                    </div>\n                </div>\n                <div class=\"flex-1 relative overflow-hidden bg-[var(--color-spruce-soft)]\" data-kid=\"1-2-2-2-2\">\n                    <img alt=\"Abstract interconnected nodes\" class=\"absolute inset-0 w-full h-full object-cover mix-blend-multiply opacity-80\" data-kid=\"1-2-2-2-2-1\" src=\"https://images.unsplash.com/photo-1669452122541-15349927d885?auto=format&w=1200&q=80&fit=crop\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-l from-transparent to-[var(--color-linen)]\" data-kid=\"1-2-2-2-2-2\">\n                    </div>\n                    <div class=\"absolute bottom-12 right-12 p-8 bg-white/90 backdrop-blur-sm border border-[var(--color-border)] rounded-3xl max-w-xs shadow-2xl\" data-kid=\"1-2-2-2-2-3\">\n                        <div class=\"flex gap-4\" data-kid=\"1-2-2-2-2-3-1\">\n                            <div class=\"w-10 h-10 rounded-full bg-[var(--color-chartreuse)] flex items-center justify-center shrink-0\" data-kid=\"1-2-2-2-2-3-1-1\">\n                                <i class=\"ti ti-hierarchy-2 text-[var(--color-spruce)]\" data-kid=\"1-2-2-2-2-3-1-1-1\">\n                                </i>\n                            </div>\n                            <div data-kid=\"1-2-2-2-2-3-1-2\">\n                                <h4 class=\"text-sm font-bold\" data-kid=\"1-2-2-2-2-3-1-2-1\">\n                                    Dynamic Reasoning\n                                </h4>\n                                <p class=\"text-xs opacity-60 mt-2 leading-relaxed\" data-kid=\"1-2-2-2-2-3-1-2-2\">\n                                    Visualizing the BFS traversal through symptoms and conditions in real-time.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Diagnostics Panel -->\n        <aside class=\"w-96 border-l border-[var(--color-border)] flex flex-col bg-[var(--color-linen)]\" data-kid=\"1-2-3\">\n            <div class=\"p-6 border-b border-[var(--color-border)] bg-white\" data-kid=\"1-2-3-1\">\n                <h2 class=\"text-lg\" data-kid=\"1-2-3-1-1\">\n                    Diagnostics\n                </h2>\n                <div class=\"flex gap-1 bg-[var(--color-linen)] p-1 rounded-xl mt-4 border border-[var(--color-border)]\" data-kid=\"1-2-3-1-2\">\n                    <button class=\"flex-1 py-2 text-[10px] font-bold uppercase tracking-wider bg-white shadow-sm border border-[var(--color-border)] rounded-lg\" data-kid=\"1-2-3-1-2-1\">\n                        Panel\n                    </button>\n                    <button class=\"flex-1 py-2 text-[10px] font-bold uppercase tracking-wider opacity-50 hover:opacity-100 transition-opacity\" data-kid=\"1-2-3-1-2-2\">\n                        Graph\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex-1 overflow-y-auto p-6 space-y-6\" data-kid=\"1-2-3-2\">\n                <!-- Urgency Alert (Conditional) -->\n                <div class=\"bg-red-50 border border-red-200 p-4 rounded-2xl\" data-kid=\"1-2-3-2-1\">\n                    <div class=\"flex items-center gap-2 text-red-600 text-[10px] font-bold uppercase tracking-widest mb-3\" data-kid=\"1-2-3-2-1-1\">\n                        <i class=\"ti ti-alert-octagon\" data-kid=\"1-2-3-2-1-1-1\">\n                        </i>\n                        Priority Red Flags\n                    </div>\n                    <div class=\"flex flex-wrap gap-2\" data-kid=\"1-2-3-2-1-2\">\n                        <span class=\"px-3 py-1 bg-red-600 text-white text-[10px] font-bold rounded-full\" data-kid=\"1-2-3-2-1-2-1\">\n                            Excessive Thirst\n                        </span>\n                        <span class=\"px-3 py-1 bg-red-600 text-white text-[10px] font-bold rounded-full\" data-kid=\"1-2-3-2-1-2-2\">\n                            Rapid Weight Loss\n                        </span>\n                    </div>\n                </div>\n                <!-- Symptoms -->\n                <div data-kid=\"1-2-3-2-2\">\n                    <h3 class=\"text-[10px] font-bold uppercase tracking-widest opacity-50 mb-4 flex items-center justify-between\" data-kid=\"1-2-3-2-2-1\">\n                        Extracted Symptoms\n                        <span class=\"px-2 py-0.5 bg-[var(--color-spruce-soft)] rounded text-[9px]\" data-kid=\"1-2-3-2-2-1-1\">\n                            4 Active\n                        </span>\n                    </h3>\n                    <div class=\"flex flex-wrap gap-2\" data-kid=\"1-2-3-2-2-2\">\n                        <div class=\"px-3 py-1.5 bg-white border border-[var(--color-border)] rounded-full text-xs font-bold flex items-center gap-2 shadow-sm\" data-kid=\"1-2-3-2-2-2-1\">\n                            <i class=\"ti ti-check text-green-600\" data-kid=\"1-2-3-2-2-2-1-1\">\n                            </i>\n                            Fatigue\n                        </div>\n                        <div class=\"px-3 py-1.5 bg-white border border-[var(--color-border)] rounded-full text-xs font-bold flex items-center gap-2 shadow-sm\" data-kid=\"1-2-3-2-2-2-2\">\n                            <i class=\"ti ti-check text-green-600\" data-kid=\"1-2-3-2-2-2-2-1\">\n                            </i>\n                            Weight Loss\n                        </div>\n                        <div class=\"px-3 py-1.5 bg-white border border-[var(--color-border)] rounded-full text-xs font-bold flex items-center gap-2 shadow-sm\" data-kid=\"1-2-3-2-2-2-3\">\n                            <i class=\"ti ti-check text-green-600\" data-kid=\"1-2-3-2-2-2-3-1\">\n                            </i>\n                            Polyuria\n                        </div>\n                        <div class=\"px-3 py-1.5 bg-white border border-[var(--color-border)] rounded-full text-xs font-bold flex items-center gap-2 shadow-sm\" data-kid=\"1-2-3-2-2-2-4\">\n                            <i class=\"ti ti-check text-green-600\" data-kid=\"1-2-3-2-2-2-4-1\">\n                            </i>\n                            Polydipsia\n                        </div>\n                    </div>\n                </div>\n                <!-- Traversal Matches -->\n                <div data-kid=\"1-2-3-2-3\">\n                    <h3 class=\"text-[10px] font-bold uppercase tracking-widest opacity-50 mb-4\" data-kid=\"1-2-3-2-3-1\">\n                        Traversal Matches\n                    </h3>\n                    <div class=\"space-y-4\" data-kid=\"1-2-3-2-3-2\">\n                        <div class=\"space-y-2\" data-kid=\"1-2-3-2-3-2-1\">\n                            <div class=\"flex justify-between items-end text-xs font-bold\" data-kid=\"1-2-3-2-3-2-1-1\">\n                                <span data-kid=\"1-2-3-2-3-2-1-1-1\">\n                                    Diabetes Mellitus (T1)\n                                </span>\n                                <span class=\"text-red-600\" data-kid=\"1-2-3-2-3-2-1-1-2\">\n                                    High Match\n                                </span>\n                            </div>\n                            <div class=\"h-2 w-full bg-white border border-[var(--color-border)] rounded-full overflow-hidden\" data-kid=\"1-2-3-2-3-2-1-2\">\n                                <div class=\"h-full bg-red-500 w-[92%] rounded-full\" data-dynamic=\"true\" data-kid=\"1-2-3-2-3-2-1-2-1\" data-name=\"diabetes diagnosis match bar\" data-reason=\"width set dynamically based on match percentage\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"space-y-2 opacity-60\" data-kid=\"1-2-3-2-3-2-2\">\n                            <div class=\"flex justify-between items-end text-xs font-bold\" data-kid=\"1-2-3-2-3-2-2-1\">\n                                <span data-kid=\"1-2-3-2-3-2-2-1-1\">\n                                    Hyperthyroidism\n                                </span>\n                                <span data-kid=\"1-2-3-2-3-2-2-1-2\">\n                                    Moderate\n                                </span>\n                            </div>\n                            <div class=\"h-2 w-full bg-white border border-[var(--color-border)] rounded-full overflow-hidden\" data-kid=\"1-2-3-2-3-2-2-2\">\n                                <div class=\"h-full bg-orange-400 w-[45%] rounded-full\" data-dynamic=\"true\" data-kid=\"1-2-3-2-3-2-2-2-1\" data-name=\"hyperthyroidism diagnosis match bar\" data-reason=\"width set dynamically based on match percentage\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- Logic Path -->\n                <div class=\"border-t border-[var(--color-border)] pt-6\" data-kid=\"1-2-3-2-4\">\n                    <h3 class=\"text-[10px] font-bold uppercase tracking-widest opacity-50 mb-4\" data-kid=\"1-2-3-2-4-1\">\n                        Reasoning Chain\n                    </h3>\n                    <div class=\"relative space-y-6 before:absolute before:left-2 before:top-2 before:bottom-2 before:w-[1px] before:bg-[var(--color-border)]\" data-kid=\"1-2-3-2-4-2\">\n                        <div class=\"relative pl-8\" data-kid=\"1-2-3-2-4-2-1\">\n                            <div class=\"absolute left-0 top-1 w-4 h-4 rounded-full bg-[var(--color-chartreuse)] border border-[var(--color-border)] z-10 flex items-center justify-center\" data-kid=\"1-2-3-2-4-2-1-1\">\n                                <div class=\"w-1 h-1 bg-[var(--color-spruce)] rounded-full\" data-kid=\"1-2-3-2-4-2-1-1-1\">\n                                </div>\n                            </div>\n                            <p class=\"text-[11px] font-bold text-[var(--color-spruce)]\" data-kid=\"1-2-3-2-4-2-1-2\">\n                                Input: Polydipsia (Increased Thirst)\n                            </p>\n                        </div>\n                        <div class=\"relative pl-8\" data-kid=\"1-2-3-2-4-2-2\">\n                            <div class=\"absolute left-0 top-1 w-4 h-4 rounded-full bg-white border border-[var(--color-border)] z-10 flex items-center justify-center\" data-kid=\"1-2-3-2-4-2-2-1\">\n                                <div class=\"w-1 h-1 bg-slate-300 rounded-full\" data-kid=\"1-2-3-2-4-2-2-1-1\">\n                                </div>\n                            </div>\n                            <p class=\"text-[11px] opacity-60\" data-kid=\"1-2-3-2-4-2-2-2\">\n                                Mapped to: Osmotic Diuresis pathway\n                            </p>\n                        </div>\n                        <div class=\"relative pl-8\" data-kid=\"1-2-3-2-4-2-3\">\n                            <div class=\"absolute left-0 top-1 w-4 h-4 rounded-full bg-[var(--color-spruce)] z-10 flex items-center justify-center\" data-dynamic=\"true\" data-kid=\"1-2-3-2-4-2-3-1\" data-name=\"reasoning chain active step icon\" data-reason=\"visibility/styling updated as reasoning progresses\">\n                                <i class=\"ti ti-check text-[8px] text-white\" data-kid=\"1-2-3-2-4-2-3-1-1\">\n                                </i>\n                            </div>\n                            <p class=\"text-[11px] font-bold\" data-kid=\"1-2-3-2-4-2-3-2\">\n                                Identified: Glucose metabolism impairment\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </aside>\n    </main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    window.addEventListener('load', () => {\n    // Entrance animations\n    const tl = gsap.timeline({\n      defaults: { duration: 0.8, ease: \"power3.out\" }\n    });\n\n    tl.from(\"nav\", { y: -20, autoAlpha: 0 })\n      .from(\"aside\", { x: -20, autoAlpha: 0 }, \"-=0.4\")\n      .from(\"#hero-split h2\", { y: 30, autoAlpha: 0 }, \"-=0.4\")\n      .from(\"#hero-split p\", { y: 20, autoAlpha: 0 }, \"-=0.6\")\n      .from(\"#hero-input-container\", { y: 20, autoAlpha: 0 }, \"-=0.6\")\n      .from(\"main aside:last-child\", { x: 20, autoAlpha: 0 }, \"-=0.8\");\n\n    // Interaction simulation\n    const heroInput = document.getElementById('hero-input');\n    const heroStart = document.getElementById('hero-start');\n    const heroSplit = document.getElementById('hero-split');\n    const chatReveal = document.getElementById('chat-reveal');\n\n    const startChat = () => {\n      if (!heroInput.value && heroInput.placeholder !== \"Describe how you're feeling today...\") return;\n      \n      gsap.to(heroSplit, { \n        autoAlpha: 0, \n        y: -50, \n        duration: 0.6, \n        ease: \"power3.inOut\",\n        onComplete: () => {\n          heroSplit.style.display = 'none';\n          chatReveal.style.pointerEvents = 'auto';\n          gsap.to(chatReveal, { autoAlpha: 1, duration: 0.6 });\n          \n          // Animate chat items\n          gsap.from(\"#chat-reveal .flex\", {\n            y: 20,\n            autoAlpha: 0,\n            stagger: 0.2,\n            duration: 0.8,\n            ease: \"power3.out\"\n          });\n        }\n      });\n    };\n\n    heroStart.addEventListener('click', startChat);\n    heroInput.addEventListener('keypress', (e) => {\n      if (e.key === 'Enter') startChat();\n    });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-07-21T14:02:10.500450+00:00",
      "modified": "2026-07-21T14:02:46.841045+00:00",
      "id": "var_30b9cf99b77a"
    },
    "var_b2d22228262a": {
      "type": "variant",
      "label": "Direction 2: Empathetic Flow",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Public+Sans:ital,wght@0,100..900;1,100..900&display=swap');\n\n  :root {\n    --bg: #F0F8FF;\n    --navy: #003262;\n    --orange: #FF9966;\n    --white: #ffffff;\n    --glass: rgba(255, 255, 255, 0.4);\n    --border: rgba(0, 50, 98, 0.1);\n  }\n\n  body {\n    font-family: 'Public Sans', sans-serif;\n    background-color: var(--bg);\n    color: var(--navy);\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  h1, h2, h3, h4 {\n    font-family: 'Lora', serif;\n    font-weight: 600;\n  }\n\n  .font-lora { font-family: 'Lora', serif; }\n  .font-sans { font-family: 'Public Sans', sans-serif; }\n\n  /* Mesh Gradient Background Blobs */\n  .blob {\n    position: absolute;\n    border-radius: 50%;\n    filter: blur(80px);\n    z-index: -1;\n    opacity: 0.4;\n  }\n\n  /* Glassmorphism utility */\n  .glass {\n    background: var(--glass);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.3);\n    box-shadow: 0 8px 32px 0 rgba(0, 50, 98, 0.05);\n  }\n\n  /* Custom Input Styling */\n  .search-input-shadow {\n    box-shadow: inset 2px 2px 8px rgba(0, 50, 98, 0.05), 4px 4px 12px rgba(255, 255, 255, 0.8);\n  }\n\n  /* Roadmap Curve */\n  .roadmap-line {\n    position: absolute;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 2px;\n    height: 100%;\n    background: repeating-linear-gradient(to bottom, var(--orange) 0, var(--orange) 10px, transparent 10px, transparent 20px);\n    z-index: -1;\n  }\n\n  .roadmap-step::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    width: 12px;\n    height: 12px;\n    background: var(--orange);\n    border-radius: 50%;\n    box-shadow: 0 0 0 8px rgba(255, 153, 102, 0.2);\n  }\n\n  [data-scroll] {\n    opacity: 0;\n    transition: opacity 0.8s ease, transform 0.8s ease;\n  }\n  [data-scroll].is-inview {\n    opacity: 1;\n    transform: none;\n  }\n</style>\n<div data-kid=\"1\" data-name=\"page layout container\" data-scroll-container=\"\">\n    <!-- Background Elements -->\n    <div class=\"blob w-[600px] h-[600px] bg-blue-200 -top-20 -left-20\" data-kid=\"1-1\" data-name=\"decorative mesh blob background\" data-scroll=\"\" data-scroll-speed=\"-2\">\n    </div>\n    <div class=\"blob w-[500px] h-[500px] bg-orange-100 top-1/2 -right-20\" data-kid=\"1-2\" data-name=\"decorative mesh blob background\" data-scroll=\"\" data-scroll-speed=\"1\">\n    </div>\n    <!-- Header -->\n    <header class=\"flex items-center justify-between px-12 py-8 relative z-10\" data-kid=\"1-3\" data-name=\"site header\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-3-1\" data-name=\"logo and branding container\">\n            <div class=\"w-10 h-10 bg-(--orange) rounded-xl flex items-center justify-center shadow-lg shadow-orange-200/50\" data-kid=\"1-3-1-1\" data-name=\"brand icon container\">\n                <svg class=\"w-6 h-6\" data-kid=\"1-3-1-1-1\" data-name=\"brand pulse icon\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                    <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\">\n                    </path>\n                </svg>\n            </div>\n            <div data-kid=\"1-3-1-2\" data-name=\"branding text container\">\n                <h1 class=\"text-xl tracking-tight leading-none\" data-kid=\"1-3-1-2-1\" data-name=\"site title\">\n                    SymptomAssist\n                </h1>\n                <p class=\"text-xs opacity-60 font-medium\" data-kid=\"1-3-1-2-2\" data-name=\"site tagline\">\n                    Empathetic Health Intelligence\n                </p>\n            </div>\n        </div>\n        <nav class=\"hidden md:flex items-center gap-8 text-sm font-semibold opacity-70\" data-kid=\"1-3-2\" data-name=\"main navigation menu\">\n            <a class=\"hover:text-(--orange) transition-colors\" data-kid=\"1-3-2-1\" data-name=\"navigation link\" href=\"#\">\n                How it Works\n            </a>\n            <a class=\"hover:text-(--orange) transition-colors\" data-kid=\"1-3-2-2\" data-name=\"navigation link\" href=\"#\">\n                Privacy First\n            </a>\n            <a class=\"hover:text-(--orange) transition-colors\" data-kid=\"1-3-2-3\" data-name=\"navigation link\" href=\"#\">\n                Research Base\n            </a>\n        </nav>\n        <div class=\"flex items-center gap-4\" data-kid=\"1-3-3\" data-name=\"header call-to-action area\">\n            <button class=\"px-6 py-2.5 rounded-full border border-(--navy)/20 text-sm font-bold hover:bg-(--navy) hover:text-white transition-all\" data-kid=\"1-3-3-1\" data-name=\"new session button\">\n                New Session\n            </button>\n        </div>\n    </header>\n    <!-- Hero: Asymmetric Bento Section -->\n    <section class=\"px-12 py-12\" data-kid=\"1-4\" data-name=\"hero section\">\n        <div class=\"grid grid-cols-12 gap-6 max-w-7xl mx-auto\" data-kid=\"1-4-1\" data-name=\"bento grid layout\">\n            <!-- Large Hero Cell -->\n            <div class=\"col-span-12 lg:col-span-8 glass rounded-[40px] p-12 flex flex-col justify-center min-h-[500px]\" data-dynamic=\"true\" data-kid=\"1-4-1-1\" data-name=\"primary hero card\" data-reason=\"animated entry via GSAP script\" id=\"hero-main\">\n                <span class=\"inline-block px-4 py-1.5 bg-blue-50 text-(--navy) text-xs font-bold rounded-full mb-6 w-fit uppercase tracking-widest\" data-kid=\"1-4-1-1-1\" data-name=\"hero category label\">\n                    Cognitive Advisor\n                </span>\n                <h2 class=\"text-6xl leading-[1.1] mb-8\" data-kid=\"1-4-1-1-2\" data-name=\"hero headline\">\n                    Your health story,\n                    <br data-kid=\"1-4-1-1-2-1\" data-name=\"headline line break\"/>\n                    <span class=\"text-(--orange) italic\" data-kid=\"1-4-1-1-2-2\" data-name=\"highlighted italic text\">\n                        understood\n                    </span>\n                    with care.\n                </h2>\n                <p class=\"text-lg opacity-70 mb-10 max-w-xl leading-relaxed\" data-kid=\"1-4-1-1-3\" data-name=\"hero description text\">\n                    Describe your symptoms in your own words. Our medical reasoning engine traverses professional knowledge to help you prepare for your next visit.\n                </p>\n                <div class=\"relative max-w-2xl\" data-kid=\"1-4-1-1-4\" data-name=\"search input container\">\n                    <input class=\"w-full bg-white/60 border border-white/40 h-16 pl-6 pr-20 rounded-2xl text-lg focus:outline-hidden focus:ring-2 focus:ring-(--orange)/20 search-input-shadow transition-all\" data-kid=\"1-4-1-1-4-1\" data-name=\"symptom search input field\" placeholder=\"Describe how you're feeling today...\" type=\"text\"/>\n                    <button class=\"absolute right-2 top-2 h-12 w-12 bg-(--navy) text-white rounded-xl flex items-center justify-center hover:bg-(--orange) transition-all\" data-kid=\"1-4-1-1-4-2\" data-name=\"submit search button\">\n                        <svg class=\"ti ti-arrow-right\" data-kid=\"1-4-1-1-4-2-1\" data-name=\"right arrow icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" width=\"24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M5 12l14 0\">\n                            </path>\n                            <path d=\"M13 18l6 -6\">\n                            </path>\n                            <path d=\"M13 6l6 -6\">\n                            </path>\n                        </svg>\n                    </button>\n                </div>\n            </div>\n            <!-- Side Cards -->\n            <div class=\"col-span-12 lg:col-span-4 grid grid-rows-2 gap-6\" data-kid=\"1-4-1-2\" data-name=\"side features column\">\n                <!-- Feature Card -->\n                <div class=\"glass rounded-[40px] p-8 overflow-hidden relative group\" data-kid=\"1-4-1-2-1\" data-name=\"research base feature card\">\n                    <img alt=\"Organic pattern\" class=\"absolute inset-0 w-full h-full object-cover opacity-10 group-hover:scale-110 transition-transform duration-1000\" data-kid=\"1-4-1-2-1-1\" data-name=\"feature background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1769096493523-b242f1277ace?auto=format&w=600&q=80&fit=crop\"/>\n                    <div class=\"relative z-10\" data-kid=\"1-4-1-2-1-2\" data-name=\"card content container\">\n                        <h3 class=\"text-2xl mb-4\" data-kid=\"1-4-1-2-1-2-1\" data-name=\"card title\">\n                            Deep Research Base\n                        </h3>\n                        <p class=\"text-sm opacity-70 leading-relaxed mb-6\" data-kid=\"1-4-1-2-1-2-2\" data-name=\"card description text\">\n                            Optionally cross-reference symptoms with live PubMed datasets for evidentiary context.\n                        </p>\n                        <div class=\"flex items-center gap-2 text-(--orange) font-bold text-sm\" data-kid=\"1-4-1-2-1-2-3\" data-name=\"card link container\">\n                            Explore capabilities\n                            <svg data-kid=\"1-4-1-2-1-2-3-1\" data-name=\"right arrow icon\" fill=\"none\" height=\"18\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"18\" xmlns=\"http://www.w3.org/2000/svg\">\n                                <path d=\"M5 12l14 0\">\n                                </path>\n                                <path d=\"M13 18l6 -6\">\n                                </path>\n                                <path d=\"M13 6l6 -6\">\n                                </path>\n                            </svg>\n                        </div>\n                    </div>\n                </div>\n                <!-- Quick Action Card -->\n                <div class=\"glass rounded-[40px] p-8 flex flex-col justify-between\" data-kid=\"1-4-1-2-2\" data-name=\"quick action card\">\n                    <div data-kid=\"1-4-1-2-2-1\" data-name=\"quick starts section\">\n                        <h3 class=\"text-xl mb-3\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"quick starts title\">\n                            Quick Starts\n                        </h3>\n                        <div class=\"flex flex-wrap gap-2\" data-kid=\"1-4-1-2-2-1-2\" data-name=\"quick starts buttons container\">\n                            <button class=\"px-4 py-2 bg-white/50 border border-white/40 rounded-full text-xs font-semibold hover:bg-(--orange) hover:text-white transition-all\" data-kid=\"1-4-1-2-2-1-2-1\" data-name=\"quick start button\">\n                                Fever & Cough\n                            </button>\n                            <button class=\"px-4 py-2 bg-white/50 border border-white/40 rounded-full text-xs font-semibold hover:bg-(--orange) hover:text-white transition-all\" data-kid=\"1-4-1-2-2-1-2-2\" data-name=\"quick start button\">\n                                Sudden Headache\n                            </button>\n                            <button class=\"px-4 py-2 bg-white/50 border border-white/40 rounded-full text-xs font-semibold hover:bg-(--orange) hover:text-white transition-all\" data-kid=\"1-4-1-2-2-1-2-3\" data-name=\"quick start button\">\n                                Back Stiffness\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"p-4 bg-(--navy)/5 rounded-2xl flex items-center gap-3\" data-kid=\"1-4-1-2-2-2\" data-name=\"engine status indicator container\">\n                        <div class=\"w-2 h-2 bg-green-500 rounded-full animate-pulse\" data-kid=\"1-4-1-2-2-2-1\" data-name=\"pulsing status dot\">\n                        </div>\n                        <span class=\"text-[10px] uppercase tracking-tighter font-bold opacity-60\" data-kid=\"1-4-1-2-2-2-2\" data-name=\"status label\">\n                            Engine Ready: Traversal score 0.98\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Reasoning Journey Section -->\n    <section class=\"py-24 px-12 overflow-hidden\" data-kid=\"1-5\" data-name=\"reasoning journey section\">\n        <div class=\"max-w-4xl mx-auto text-center mb-20\" data-kid=\"1-5-1\" data-name=\"journey section title container\">\n            <h2 class=\"text-4xl mb-6\" data-kid=\"1-5-1-1\" data-name=\"journey section heading\">\n                How your analysis flows\n            </h2>\n            <p class=\"text-lg opacity-60\" data-kid=\"1-5-1-2\" data-name=\"journey section description\">\n                A multi-modal journey from clinical description to medical reasoning.\n            </p>\n        </div>\n        <div class=\"relative max-w-3xl mx-auto space-y-32\" data-kid=\"1-5-2\" data-name=\"roadmap container\">\n            <div class=\"roadmap-line\" data-kid=\"1-5-2-1\" data-name=\"roadmap vertical line\">\n            </div>\n            <!-- Step 1 -->\n            <div class=\"roadmap-step relative flex flex-col items-center\" data-dynamic=\"true\" data-kid=\"1-5-2-2\" data-name=\"roadmap step one container\" data-reason=\"opacity and position animated by scroll script\" data-scroll=\"\" data-scroll-speed=\"0.5\">\n                <div class=\"glass p-8 rounded-3xl w-full max-w-md text-center\" data-kid=\"1-5-2-2-1\" data-name=\"card container\">\n                    <div class=\"w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6 text-(--navy)\" data-kid=\"1-5-2-2-1-1\" data-name=\"step icon container\">\n                        <svg class=\"ti ti-message-2\" data-kid=\"1-5-2-2-1-1-1\" data-name=\"step icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M12 20l-3 -3h-2a3 3 0 0 1 -3 -3v-6a3 3 0 0 1 3 -3h10a3 3 0 0 1 3 3v6a3 3 0 0 1 -3 3h-2l-3 3\">\n                            </path>\n                            <path d=\"M8 9l8 0\">\n                            </path>\n                            <path d=\"M8 13l6 0\">\n                            </path>\n                        </svg>\n                    </div>\n                    <h4 class=\"text-xl mb-2\" data-kid=\"1-5-2-2-1-2\" data-name=\"step title\">\n                        Symptom Extraction\n                    </h4>\n                    <p class=\"text-sm opacity-60\" data-kid=\"1-5-2-2-1-3\" data-name=\"step description text\">\n                        Our NLP extractor identifies specific medical entities from your natural language description.\n                    </p>\n                </div>\n            </div>\n            <!-- Step 2 -->\n            <div class=\"roadmap-step relative flex flex-col items-center\" data-dynamic=\"true\" data-kid=\"1-5-2-3\" data-name=\"roadmap step two container\" data-reason=\"opacity and position animated by scroll script\" data-scroll=\"\" data-scroll-speed=\"0.8\">\n                <div class=\"glass p-8 rounded-3xl w-full max-w-md text-center\" data-kid=\"1-5-2-3-1\" data-name=\"card container\">\n                    <div class=\"w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-6 text-(--orange)\" data-kid=\"1-5-2-3-1-1\" data-name=\"step icon container\">\n                        <svg class=\"ti ti-binary-tree-2\" data-kid=\"1-5-2-3-1-1-1\" data-name=\"step icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M5 12h-4l-3 9L9 3l-3 9H2\">\n                            </path>\n                        </svg>\n                    </div>\n                    <h4 class=\"text-xl mb-2\" data-kid=\"1-5-2-3-1-2\" data-name=\"step title\">\n                        Graph Traversal\n                    </h4>\n                    <p class=\"text-sm opacity-60\" data-kid=\"1-5-2-3-1-3\" data-name=\"step description text\">\n                        A Bayesian BFS traversal through our medical knowledge graph finds high-probability matches.\n                    </p>\n                </div>\n            </div>\n            <!-- Step 3 -->\n            <div class=\"roadmap-step relative flex flex-col items-center\" data-dynamic=\"true\" data-kid=\"1-5-2-4\" data-name=\"roadmap step three container\" data-reason=\"opacity and position animated by scroll script\" data-scroll=\"\" data-scroll-speed=\"1\">\n                <div class=\"glass p-8 rounded-3xl w-full max-w-md text-center\" data-kid=\"1-5-2-4-1\" data-name=\"card container\">\n                    <div class=\"w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6 text-green-700\" data-kid=\"1-5-2-4-1-1\" data-name=\"step icon container\">\n                        <svg class=\"ti ti-report-medical\" data-kid=\"1-5-2-4-1-1-1\" data-name=\"step icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2\">\n                            </path>\n                            <path d=\"M9 3m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v0a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z\">\n                     