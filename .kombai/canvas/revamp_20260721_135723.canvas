a-kid=\"1-6-1-1-3-1-1\" data-name=\"benefit icon container\">\n                            <i class=\"ti ti-check text-(--navy)\" data-kid=\"1-6-1-1-3-1-1-1\" data-name=\"check icon\">\n                            </i>\n                        </div>\n                        <p class=\"text-lg opacity-80 font-medium\" data-kid=\"1-6-1-1-3-1-2\" data-name=\"benefit text\">\n                            Clear symptom prioritization to help you start the conversation.\n                        </p>\n                    </div>\n                    <div class=\"flex gap-4\" data-kid=\"1-6-1-1-3-2\" data-name=\"benefit item\">\n                        <div class=\"w-10 h-10 rounded-full bg-(--navy)/5 flex items-center justify-center shrink-0\" data-kid=\"1-6-1-1-3-2-1\" data-name=\"benefit icon container\">\n                            <i class=\"ti ti-check text-(--navy)\" data-kid=\"1-6-1-1-3-2-1-1\" data-name=\"check icon\">\n                            </i>\n                        </div>\n                        <p class=\"text-lg opacity-80 font-medium\" data-kid=\"1-6-1-1-3-2-2\" data-name=\"benefit text\">\n                            Automatic detection of priority red flags for immediate care.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"grid grid-cols-2 gap-4\" data-dynamic=\"true\" data-kid=\"1-6-1-2\" data-name=\"diagnostics visualization grid\" data-reason=\"opacity and position animated by scroll script\" data-scroll=\"\" data-scroll-speed=\"2\">\n                <!-- Diagnostic Widget 1 -->\n                <div class=\"glass p-6 rounded-3xl col-span-2\" data-kid=\"1-6-1-2-1\" data-name=\"potential matches widget\">\n                    <div class=\"flex justify-between items-center mb-6\" data-kid=\"1-6-1-2-1-1\" data-name=\"widget header\">\n                        <h4 class=\"text-sm font-bold uppercase tracking-widest opacity-40\" data-kid=\"1-6-1-2-1-1-1\" data-name=\"widget title\">\n                            Potential Matches\n                        </h4>\n                        <span class=\"px-2 py-1 bg-(--orange)/10 text-(--orange) text-[10px] font-bold rounded\" data-kid=\"1-6-1-2-1-1-2\" data-name=\"widget status badge\">\n                            Live Analysis\n                        </span>\n                    </div>\n                    <div class=\"space-y-6\" data-kid=\"1-6-1-2-1-2\" data-name=\"progress bars container\">\n                        <div data-kid=\"1-6-1-2-1-2-1\" data-name=\"diagnostic item one\">\n                            <div class=\"flex justify-between text-xs font-bold mb-2\" data-kid=\"1-6-1-2-1-2-1-1\" data-name=\"diagnostic item label container\">\n                                <span data-kid=\"1-6-1-2-1-2-1-1-1\" data-name=\"diagnostic item title\">\n                                    Hyperthyroidism\n                                </span>\n                                <span class=\"text-(--orange)\" data-kid=\"1-6-1-2-1-2-1-1-2\" data-name=\"diagnostic risk label\">\n                                    Medium\n                                </span>\n                            </div>\n                            <div class=\"h-1.5 w-full bg-(--navy)/5 rounded-full overflow-hidden\" data-kid=\"1-6-1-2-1-2-1-2\" data-name=\"progress track\">\n                                <div class=\"h-full bg-(--orange) rounded-full w-[65%]\" data-kid=\"1-6-1-2-1-2-1-2-1\" data-name=\"progress fill\">\n                                </div>\n                            </div>\n                        </div>\n                        <div data-kid=\"1-6-1-2-1-2-2\" data-name=\"diagnostic item two\">\n                            <div class=\"flex justify-between text-xs font-bold mb-2\" data-kid=\"1-6-1-2-1-2-2-1\" data-name=\"diagnostic item label container\">\n                                <span data-kid=\"1-6-1-2-1-2-2-1-1\" data-name=\"diagnostic item title\">\n                                    Tension Headache\n                                </span>\n                                <span class=\"text-green-600\" data-kid=\"1-6-1-2-1-2-2-1-2\" data-name=\"diagnostic risk label\">\n                                    Low\n                                </span>\n                            </div>\n                            <div class=\"h-1.5 w-full bg-(--navy)/5 rounded-full overflow-hidden\" data-kid=\"1-6-1-2-1-2-2-2\" data-name=\"progress track\">\n                                <div class=\"h-full bg-green-500 rounded-full w-[25%]\" data-kid=\"1-6-1-2-1-2-2-2-1\" data-name=\"progress fill\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- Diagnostic Widget 2 -->\n                <div class=\"glass p-6 rounded-3xl aspect-square flex flex-col justify-between\" data-kid=\"1-6-1-2-2\" data-name=\"symptoms widget\">\n                    <h4 class=\"text-[10px] font-bold uppercase tracking-widest opacity-40\" data-kid=\"1-6-1-2-2-1\" data-name=\"widget title\">\n                        Symptoms\n                    </h4>\n                    <div class=\"flex flex-wrap gap-2\" data-kid=\"1-6-1-2-2-2\" data-name=\"symptom tags container\">\n                        <span class=\"px-2 py-1 bg-blue-100 text-(--navy) text-[10px] font-bold rounded-lg\" data-kid=\"1-6-1-2-2-2-1\" data-name=\"symptom tag\">\n                            Fatigue\n                        </span>\n                        <span class=\"px-2 py-1 bg-blue-100 text-(--navy) text-[10px] font-bold rounded-lg\" data-kid=\"1-6-1-2-2-2-2\" data-name=\"symptom tag\">\n                            Thirst\n                        </span>\n                    </div>\n                </div>\n                <!-- Diagnostic Widget 3 -->\n                <div class=\"glass p-6 rounded-3xl aspect-square flex flex-col justify-between\" data-kid=\"1-6-1-2-3\" data-name=\"red flags widget\">\n                    <h4 class=\"text-[10px] font-bold uppercase tracking-widest opacity-40\" data-kid=\"1-6-1-2-3-1\" data-name=\"widget title\">\n                        Red Flags\n                    </h4>\n                    <div class=\"w-10 h-10 rounded-full bg-red-100 flex items-center justify-center\" data-kid=\"1-6-1-2-3-2\" data-name=\"alert icon container\">\n                        <svg class=\"ti ti-alert-triangle\" data-kid=\"1-6-1-2-3-2-1\" data-name=\"alert icon\" fill=\"none\" height=\"20\" stroke=\"#ef4444\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" width=\"20\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M12 9v4\">\n                            </path>\n                            <path d=\"M12 17h.01\">\n                            </path>\n                            <path d=\"M12 3l8.5 14.5a2 2 0 0 1 -1.7 3h-13.6a2 2 0 0 1 -1.7 -3l8.5 -14.5z\">\n                            </path>\n                        </svg>\n                    </div>\n                    <p class=\"text-[10px] font-bold text-red-600\" data-kid=\"1-6-1-2-3-3\" data-name=\"alert status text\">\n                        None detected\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"px-12 py-16 border-t border-(--navy)/5\" data-kid=\"1-7\" data-name=\"footer section\">\n        <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between gap-12\" data-kid=\"1-7-1\" data-name=\"footer main content area\">\n            <div class=\"max-w-sm\" data-kid=\"1-7-1-1\" data-name=\"footer branding and disclaimer\">\n                <div class=\"flex items-center gap-3 mb-6\" data-kid=\"1-7-1-1-1\" data-name=\"footer logo container\">\n                    <div class=\"w-8 h-8 bg-(--navy) rounded-lg flex items-center justify-center\" data-kid=\"1-7-1-1-1-1\" data-name=\"footer logo icon container\">\n                        <svg class=\"w-5 h-5\" data-kid=\"1-7-1-1-1-1-1\" data-name=\"footer logo icon\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                            <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\">\n                            </path>\n                        </svg>\n                    </div>\n                    <h3 class=\"text-lg font-lora\" data-kid=\"1-7-1-1-1-2\" data-name=\"footer site title\">\n                        SymptomAssist\n                    </h3>\n                </div>\n                <p class=\"text-sm opacity-50 leading-relaxed\" data-kid=\"1-7-1-1-2\" data-name=\"disclaimer text\">\n                    Not a substitute for professional medical advice. If you have an emergency, call 108 (or your local emergency number).\n                </p>\n            </div>\n            <div class=\"grid grid-cols-2 gap-16\" data-kid=\"1-7-1-2\" data-name=\"footer links grid\">\n                <div data-kid=\"1-7-1-2-1\" data-name=\"project links column\">\n                    <h4 class=\"text-xs font-bold uppercase tracking-widest mb-6\" data-kid=\"1-7-1-2-1-1\" data-name=\"column header\">\n                        Project\n                    </h4>\n                    <ul class=\"space-y-4 text-sm font-medium opacity-60\" data-kid=\"1-7-1-2-1-2\" data-name=\"links list\">\n                        <li data-kid=\"1-7-1-2-1-2-1\" data-name=\"list item\">\n                            <a class=\"hover:text-(--orange)\" data-kid=\"1-7-1-2-1-2-1-1\" data-name=\"link\" href=\"#\">\n                                Methodology\n                            </a>\n                        </li>\n                        <li data-kid=\"1-7-1-2-1-2-2\" data-name=\"list item\">\n                            <a class=\"hover:text-(--orange)\" data-kid=\"1-7-1-2-1-2-2-1\" data-name=\"link\" href=\"#\">\n                                Open Source\n                            </a>\n                        </li>\n                        <li data-kid=\"1-7-1-2-1-2-3\" data-name=\"list item\">\n                            <a class=\"hover:text-(--orange)\" data-kid=\"1-7-1-2-1-2-3-1\" data-name=\"link\" href=\"#\">\n                                Security\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-7-1-2-2\" data-name=\"support links column\">\n                    <h4 class=\"text-xs font-bold uppercase tracking-widest mb-6\" data-kid=\"1-7-1-2-2-1\" data-name=\"column header\">\n                        Support\n                    </h4>\n                    <ul class=\"space-y-4 text-sm font-medium opacity-60\" data-kid=\"1-7-1-2-2-2\" data-name=\"links list\">\n                        <li data-kid=\"1-7-1-2-2-2-1\" data-name=\"list item\">\n                            <a class=\"hover:text-(--orange)\" data-kid=\"1-7-1-2-2-2-1-1\" data-name=\"link\" href=\"#\">\n                                Documentation\n                            </a>\n                        </li>\n                        <li data-kid=\"1-7-1-2-2-2-2\" data-name=\"list item\">\n                            <a class=\"hover:text-(--orange)\" data-kid=\"1-7-1-2-2-2-2-1\" data-name=\"link\" href=\"#\">\n                                Guidelines\n                            </a>\n                        </li>\n                        <li data-kid=\"1-7-1-2-2-2-3\" data-name=\"list item\">\n                            <a class=\"hover:text-(--orange)\" data-kid=\"1-7-1-2-2-2-3-1\" data-name=\"link\" href=\"#\">\n                                Contact\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n        <div class=\"max-w-7xl mx-auto mt-16 pt-8 border-t border-(--navy)/5 flex justify-between items-center text-[10px] font-bold opacity-40 uppercase tracking-widest\" data-kid=\"1-7-2\" data-name=\"footer bottom bar\">\n            <p data-kid=\"1-7-2-1\" data-name=\"copyright text\">\n                © 2026 SymptomAssist AI Research Team\n            </p>\n            <div class=\"flex gap-6\" data-kid=\"1-7-2-2\" data-name=\"legal links container\">\n                <a data-kid=\"1-7-2-2-1\" data-name=\"privacy link\" href=\"#\">\n                    Privacy\n                </a>\n                <a data-kid=\"1-7-2-2-2\" data-name=\"terms link\" href=\"#\">\n                    Terms\n                </a>\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.min.js\">\n</script>\n<script type=\"module\">\n    import { animate, scroll, spring } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  // Initialize Locomotive Scroll\n  const locomotiveScroll = new LocomotiveScroll({\n    lenisOptions: {\n      duration: 1.2,\n      lerp: 0.1,\n    }\n  });\n\n  // Spring entrance for bento cells\n  animate(\"#hero-main\", \n    { opacity: [0, 1], scale: [0.95, 1], y: [40, 0] }, \n    { duration: 0.8, ease: \"easeOut\" }\n  );\n\n  // Stagger reveal for the roadmap steps using motion scroll progress\n  const roadmapSteps = document.querySelectorAll('.roadmap-step');\n  roadmapSteps.forEach((step, i) => {\n    scroll(\n      animate(step, { opacity: [0, 1], y: [50, 0] }),\n      { target: step, offset: [\"start end\", \"end end\"] }\n    );\n  });\n</script>\n<link data-kid=\"2\" data-name=\"locomotive scroll stylesheet\" href=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.css\" rel=\"stylesheet\"/>\n<link data-kid=\"3\" data-name=\"tabler icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n",
